# Postgres locale (docker compose) — in prod usa Supabase/Neon con sslmode=require
DATABASE_URL="postgresql://fantasta:fantasta@localhost:5432/fantasta?schema=public"

# HTTP
PORT=3000

# CORS / Socket origin del frontend. Accetta più origin separati da virgola
# (dominio definitivo, anteprime `*.pages.dev`, localhost per il debug):
# FRONTEND_ORIGIN="https://fantasta-auction.pages.dev,http://localhost:4200"
FRONTEND_ORIGIN="http://localhost:4200"

# Auth admin (boilerplate: token condiviso). È sia l'header `x-admin-token` delle
# rotte REST sia il token con cui l'admin fa `auth` sul socket: è quello che si
# digita nella schermata d'accesso spuntando "entra come admin".
# Senza questa variabile nessuno può diventare admin.
ADMIN_TOKEN="cambia-questo-token"

# Firma le sessioni dei partecipanti (il JWT che nasce dal magic link e resta nel
# localStorage del telefono). Senza, il backend NON parte: una sessione firmata con
# un segreto vuoto la fabbrica chiunque. Cambiarlo invalida tutte le sessioni aperte
# — i link e i codici continuano a funzionare.
JWT_SECRET="cambia-questo-segreto"

# Il timer di rilancio NON è una env: è la regola di lega `bidTimerSeconds`
# (PUT /rules), perché l'admin la cambia a serata in corso.
